{
  "name": "OpenParking Dev",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",

  "features": {
    // .NET 8 SDK
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "8.0"
    },
    // Python 3.11
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    },
    // Node 20 (for React + Cloudflare Worker)
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    // Flutter (from community features)
    "ghcr.io/jarrodcolburn/features/flutter-sdk:0": {
      "version": "stable"
    },
    // Docker-in-Docker (so you can run docker compose inside Codespaces)
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    // GitHub CLI (gh)
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // Use docker-compose.yml for the full service stack
  "dockerComposeFile": "../docker-compose.yml",
  "service": "api",
  "workspaceFolder": "/workspace",

  // Forward all the ports you need
  "forwardPorts": [
    5000,  // ASP.NET Core API
    8000,  // Python AI service
    5432,  // PostgreSQL (local dev db)
    5173   // React Vite dev server
  ],

  "portsAttributes": {
    "5000": { "label": "ASP.NET Core API", "onAutoForward": "notify" },
    "8000": { "label": "AI Service (LangGraph)", "onAutoForward": "notify" },
    "5173": { "label": "React Web App", "onAutoForward": "openBrowser" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "silent" }
  },

  // Run setup automatically when the container is created
  "postCreateCommand": "make setup",

  // VS Code extensions pre-installed for every team member
  "customizations": {
    "vscode": {
      "extensions": [
        // C# / .NET
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        // Flutter / Dart
        "Dart-Code.flutter",
        "Dart-Code.dart-code",
        // Python / AI
        "ms-python.python",
        "ms-python.pylance",
        "ms-python.mypy-type-checker",
        // React / TypeScript
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        // REST / API testing
        "humao.rest-client",
        "42Crunch.vscode-openapi",
        // Database
        "ckolkman.vscode-postgres",
        // Git
        "eamodio.gitlens",
        "mhutchie.git-graph",
        // Docker
        "ms-azuretools.vscode-docker",
        // Cloudflare
        "cloudflare.cloudflare-workers-bindings"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[csharp]": {
          "editor.defaultFormatter": "ms-dotnettools.csharp"
        },
        "[dart]": {
          "editor.defaultFormatter": "Dart-Code.dart-code"
        },
        "[python]": {
          "editor.defaultFormatter": "ms-python.python"
        },
        "python.defaultInterpreterPath": "/usr/local/bin/python3.11",
        "dotnet.defaultSolution": "api/OpenParking.sln"
      }
    }
  }
}
