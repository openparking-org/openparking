# =============================================================================
# OpenParking — Environment Configuration Template
# Copy this file to .env and fill in real values for local development
# =============================================================================

# Database (Neon serverless or local Postgres)
# The Python AI service reads DATABASE_URL and expects a postgresql:// URI.
# ASP.NET Core / Npgsql cannot parse URIs, so the API takes a keyword
# connection string instead. Keep both pointed at the same database.
DATABASE_URL=postgresql://dev:dev@localhost:5432/openparking
API_CONNECTION_STRING=Host=localhost;Port=5432;Database=openparking;Username=dev;Password=dev

# Auth
JWT_SECRET=change-this-to-a-super-secret-key-at-least-32-chars-long
JWT_EXPIRY_HOURS=24

# Third-party Integrations
MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoiZGVtbyIsImEiOiJjbGV4YW1wbGUifQ.demo
RESEND_API_KEY=re_demo_123456789

# Cloudflare Workers AI
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_AI_TOKEN=your-cloudflare-ai-api-token
CF_AI_MODE=mock

# Cloudflare Tunnel & Storage (Production)
CF_TUNNEL_TOKEN=your-cloudflared-tunnel-token
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=openparking-assets

# Service URLs
AI_SERVICE_URL=http://localhost:8000
API_BASE_URL=http://localhost:5000
